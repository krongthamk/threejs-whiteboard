# Reference values only: the server reads exported environment variables and does
# not automatically load .env files. Google sign-in stays off without this file.
WHITEBOARD_GOOGLE_ENABLED=0

# Optional server settings. Use an absolute data directory when overriding it.
# WHITEBOARD_DATA_DIR=/absolute/path/to/whiteboard-data
# HOST=127.0.0.1
# PORT=3001

# Remote HTTPS deployment behind a reverse proxy on the same host.
# Set these in the service environment; copying this file alone does not load it.
# WHITEBOARD_STATIC_DIR=/absolute/path/to/threejs-whiteboard/packages/app/dist
# WHITEBOARD_ORIGINS=https://board.example.com
# WHITEBOARD_SECURE_COOKIES=1
# Enable only when direct access to the backend is restricted and the proxy
# overwrites/appends the actual client address as the last X-Forwarded-For hop.
# WHITEBOARD_TRUSTED_PROXY=1
# WHITEBOARD_DRAIN_MS=5000
# The server generates WHITEBOARD_DATA_DIR/session-secret on first startup.
# Preserve that file with the database and assets across deployments.

# To re-enable Google, set WHITEBOARD_GOOGLE_ENABLED=1 and configure all of:
# WHITEBOARD_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# WHITEBOARD_PUBLIC_URL=http://127.0.0.1:3001
# WHITEBOARD_GOOGLE_CLIENT_SECRET_FILE=google-client-secret
# WHITEBOARD_GOOGLE_ALLOWED_EMAILS=you@example.com
# The secret file must be mode 0600 inside WHITEBOARD_DATA_DIR.
# Never put passwords, session secrets, or real OAuth credentials in this file.
