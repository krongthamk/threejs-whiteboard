# Copy to deploy/.env. These are deployment settings, not application secrets.
# DNS name only, without https://, path or trailing slash.
WHITEBOARD_DOMAIN=board.example.com
WHITEBOARD_IMAGE=threejs-whiteboard:local
WHITEBOARD_LOCAL_PORT=3001
WHITEBOARD_MEMORY_LIMIT=2g
WHITEBOARD_DATA_VOLUME=threejs-whiteboard-data
WHITEBOARD_RESTORE_VOLUME=threejs-whiteboard-restored
# Unique across deployments sharing a backup repository; keep stable on redeploy.
WHITEBOARD_BACKUP_HOST=company-whiteboard-production
