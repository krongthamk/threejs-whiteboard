# Copy to deploy/backup.env, mode 0600. Supply a dedicated OFF-HOST repository.
# Do not put a password in the repository URL. The encryption password is a file
# at deploy/secrets/restic-password, readable by container UID 1000 only.
RESTIC_REPOSITORY=s3:https://s3.example.com/whiteboard-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible services:
# AWS_DEFAULT_REGION=us-east-1
