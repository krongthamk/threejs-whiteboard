{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@whiteboard/model": [
        "./packages/model/src/index.ts"
      ],
      "@whiteboard/renderer": [
        "./packages/renderer/src/index.ts"
      ]
    }
  },
  "include": [
    "packages",
    "spikes",
    "tests",
    "scripts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "**/results/**",
    "**/reports/**"
  ]
}
